+QPixmap ScreenGrabber::nativeSwayScreenshot(int monitorIndex)
+{
+#if defined(Q_OS_UNIX) && !defined(Q_OS_MACOS)
+    if (qEnvironmentVariable("XDG_SESSION_TYPE") != QLatin1String("wayland") ||
+        QGuiApplication::platformName() != QLatin1String("wayland") ||
+        !qEnvironmentVariable("XDG_CURRENT_DESKTOP")
+           .split(QLatin1Char(':'), Qt::SkipEmptyParts)
+           .contains(QLatin1String("sway"), Qt::CaseInsensitive)) {
+        return QPixmap();
+    }
+
+    const QList<QScreen*> screens = QGuiApplication::screens();
+    if (monitorIndex < 0 || monitorIndex >= screens.size()) {
+        return QPixmap();
+    }
+
+    QScreen* screen = screens[monitorIndex];
+    const QString outputName = screen->name();
+    const QString grim = QStandardPaths::findExecutable(QStringLiteral("grim"));
+    if (outputName.isEmpty() || grim.isEmpty()) {
+        AbstractLogger::warning()
+          << tr("Native Sway capture unavailable; using the portal screenshot");
+        return QPixmap();
+    }
+
+    QProcess process;
+    process.setProgram(grim);
+    process.setArguments({ QStringLiteral("-o"), outputName,
+                           QStringLiteral("-") });
+    process.start();
+    if (!process.waitForStarted(5000) || !process.waitForFinished(30000) ||
+        process.exitStatus() != QProcess::NormalExit ||
+        process.exitCode() != 0) {
+        if (process.state() != QProcess::NotRunning) {
+            process.kill();
+            process.waitForFinished();
+        }
+        AbstractLogger::warning()
+          << tr("Native Sway capture failed for %1: %2")
+               .arg(outputName, QString::fromLocal8Bit(process.readAllStandardError()));
+        return QPixmap();
+    }
+
+    QPixmap screenshot;
+    if (!screenshot.loadFromData(process.readAllStandardOutput(), "PNG")) {
+        AbstractLogger::warning()
+          << tr("Native Sway capture returned an invalid PNG for %1")
+               .arg(outputName);
+        return QPixmap();
+    }
+
+    const QSize expectedSize(
+      qRound(screen->geometry().width() * screen->devicePixelRatio()),
+      qRound(screen->geometry().height() * screen->devicePixelRatio()));
+    if (screenshot.size() != expectedSize) {
+        AbstractLogger::warning()
+          << tr("Native Sway capture size mismatch for %1: %2x%3, expected %4x%5")
+               .arg(outputName)
+               .arg(screenshot.width())
+               .arg(screenshot.height())
+               .arg(expectedSize.width())
+               .arg(expectedSize.height());
+        return QPixmap();
+    }
+
+    screenshot.setDevicePixelRatio(screen->devicePixelRatio());
+    return screenshot;
+#else
+    Q_UNUSED(monitorIndex)
+    return QPixmap();
+#endif
+}
+
+QPixmap ScreenGrabber::captureSelectedMonitor(const QPixmap& fullScreenshot,
+                                               int monitorIndex)
+{
+    QPixmap screenshot = nativeSwayScreenshot(monitorIndex);
+    return screenshot.isNull() ? cropToMonitor(fullScreenshot, monitorIndex)
+                               : screenshot;
 }
 
